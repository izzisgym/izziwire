# Database (Postgres – required for Render; for local: Docker or e.g. Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/linkedin_agent"

# LinkedIn OAuth (from https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://localhost:3000/auth/linkedin/callback

# AI (Anthropic) for post and comment generation
ANTHROPIC_API_KEY=
DEFAULT_AI_MODEL=claude-sonnet-4-5-20250514

# App
PORT=3001
API_KEY=
CRON_SECRET=
# Required when hosted (use a long random string)
SESSION_SECRET=

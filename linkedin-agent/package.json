{
  "name": "linkedin-agent",
  "version": "1.0.0",
  "description": "LinkedIn automation: OAuth, post creation, topic-driven content, approval queue",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "node-cron": "^4.2.1",
    "@anthropic-ai/sdk": "^0.71.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "@types/express-session": "^1.18.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
